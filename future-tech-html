<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lotus Cybersecurity | Future Tech</title>
  <meta
    name="description"
    content="Blossom is Lotus Cybersecurity's future-facing vision for intelligent security assistance, client visibility, and smarter defensive operations."
  />
  <link rel="stylesheet" href="style.css" />

  <style>
    .future-hero{
      position:relative;
      overflow:hidden;
      padding:110px 0 80px;
    }

    .future-hero::before{
      content:"";
      position:absolute;
      inset:-10%;
      background:
        radial-gradient(circle at 18% 22%, rgba(122,215,255,0.18), transparent 18%),
        radial-gradient(circle at 82% 18%, rgba(111,90,255,0.15), transparent 18%),
        radial-gradient(circle at 74% 74%, rgba(122,215,255,0.10), transparent 18%);
      pointer-events:none;
    }

    .future-particles{
      position:absolute;
      inset:0;
      pointer-events:none;
      opacity:0.12;
      background-image:radial-gradient(rgba(122,215,255,0.65) 1.2px, transparent 1.2px);
      background-size:64px 64px;
      animation: futureFloat 30s linear infinite;
    }

    .future-hero .container{
      position:relative;
      z-index:1;
    }

    .future-hero-grid{
      display:grid;
      grid-template-columns:1.02fr 0.98fr;
      gap:34px;
      align-items:center;
    }

    .future-hero h1{
      margin:0 0 18px;
      font-size:clamp(2.8rem, 5.3vw, 4.8rem);
      line-height:1.02;
      letter-spacing:-0.04em;
      max-width:820px;
    }

    .future-copy{
      color:var(--muted);
      font-size:1.08rem;
      max-width:760px;
    }

    .future-pill{
      display:inline-flex;
      align-items:center;
      gap:10px;
      padding:10px 16px;
      margin-top:20px;
      border-radius:999px;
      background:rgba(255,255,255,0.04);
      border:1px solid rgba(122,215,255,0.16);
      color:var(--muted);
      font-size:0.95rem;
    }

    .future-pill strong{
      color:var(--text);
    }

    .future-actions{
      display:flex;
      flex-wrap:wrap;
      gap:14px;
      margin-top:28px;
    }

    .future-visual{
      position:relative;
    }

    .future-image-shell{
      padding:14px;
      position:relative;
      overflow:hidden;
    }

    .future-image-shell::before{
      content:"";
      position:absolute;
      inset:-20%;
      background:
        conic-gradient(
          from 0deg,
          rgba(122,215,255,0.18),
          rgba(255,255,255,0.02),
          rgba(111,90,255,0.15),
          rgba(122,215,255,0.18)
        );
      filter:blur(30px);
      opacity:0.65;
      animation: slowSpin 18s linear infinite;
      pointer-events:none;
    }

    .future-image{
      width:100%;
      border-radius:18px;
      object-fit:cover;
      position:relative;
      z-index:1;
    }

    .future-overlay-top,
    .future-overlay-bottom{
      position:absolute;
      z-index:2;
      backdrop-filter:blur(10px);
      background:rgba(3,8,19,0.78);
      border:1px solid rgba(122,215,255,0.16);
      border-radius:18px;
      box-shadow:var(--shadow);
    }

    .future-overlay-top{
      top:22px;
      left:22px;
      padding:14px 16px;
      min-width:190px;
    }

    .future-overlay-bottom{
      right:22px;
      bottom:22px;
      padding:16px 18px;
      min-width:220px;
    }

    .future-overlay-top strong,
    .future-overlay-bottom strong{
      display:block;
      margin-bottom:5px;
      font-size:1rem;
    }

    .future-overlay-top span,
    .future-overlay-bottom span{
      display:block;
      color:var(--muted);
      font-size:0.92rem;
    }

    .future-section-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:22px;
    }

    .future-card{
      padding:28px;
      position:relative;
      overflow:hidden;
    }

    .future-card::before{
      content:"";
      position:absolute;
      inset:0;
      background:linear-gradient(180deg, rgba(122,215,255,0.04), rgba(255,255,255,0.01));
      pointer-events:none;
    }

    .future-card > *{
      position:relative;
      z-index:1;
    }

    .future-card h3{
      margin-top:0;
      margin-bottom:10px;
    }

    .future-card p{
      color:var(--muted);
      margin-bottom:0;
    }

    .future-roadmap{
      display:grid;
      grid-template-columns:1.02fr 0.98fr;
      gap:22px;
      align-items:stretch;
    }

    .roadmap-story,
    .roadmap-points{
      padding:30px;
    }

    .roadmap-story h2,
    .roadmap-points h2{
      margin-top:0;
      margin-bottom:12px;
    }

    .roadmap-story p,
    .roadmap-points p,
    .roadmap-points li{
      color:var(--muted);
    }

    .roadmap-points ul{
      margin:0;
      padding-left:18px;
    }

    .future-comparison{
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:22px;
    }

    .compare-box{
      padding:28px;
    }

    .compare-box h3{
      margin-top:0;
      margin-bottom:10px;
    }

    .compare-box p,
    .compare-box li{
      color:var(--muted);
    }

    .compare-box ul{
      margin:0;
      padding-left:18px;
    }

    .future-cta{
      padding:34px;
      text-align:center;
    }

    .future-cta p{
      max-width:760px;
      margin:0 auto 22px;
      color:var(--muted);
    }

    @keyframes futureFloat{
      0%{ transform:translate3d(0,0,0); }
      100%{ transform:translate3d(-50px,-35px,0); }
    }

    @keyframes slowSpin{
      from{ transform:rotate(0deg); }
      to{ transform:rotate(360deg); }
    }

    @media (max-width: 980px){
      .future-hero-grid,
      .future-section-grid,
      .future-roadmap,
      .future-comparison{
        grid-template-columns:1fr;
      }

      .future-hero{
        padding-top:90px;
      }
    }

    @media (max-width: 640px){
      .future-hero h1{
        font-size:clamp(2.4rem, 11vw, 3.5rem);
      }

      .future-actions{
        flex-direction:column;
        align-items:flex-start;
      }

      .future-overlay-top,
      .future-overlay-bottom{
        position:static;
        margin-top:14px;
      }
    }
  </style>
</head>
<body>
  <div class="grid-bg"></div>

